# Required environment variables for the backend

# SQLCipher encryption key for courier.db — keep secret, never commit
DB_ENCRYPTION_KEY=your_encryption_key_here

# Port the server listens on (Railway injects this automatically)
PORT=5000

# Comma-separated list of allowed frontend origins (e.g. your Vercel URL)
# Example: ALLOWED_ORIGIN=https://brisknetwork.vercel.app
ALLOWED_ORIGIN=
